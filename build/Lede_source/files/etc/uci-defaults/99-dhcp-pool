#!/bin/sh
# 2026-10-24: 官方默认 dhcp.lan.start='1' / limit='150'，动态池是 192.168.50.1-150。
# 池子的低位段本该留给固定设备，实际却把 .1（不少设备默认当网关）、.2（路由器自己）
# 和 .10 这类手配地址的机器一起圈了进去，dnsmasq 一旦把 .10 发给别人就是地址冲突。
# 这里只处理"还是出厂 1/150"的机器：挪到 .30 起、120 个地址（.30-.149），
# 已经手工调过池子的机器不动（守卫 cur_start = 1）。
[ -f /etc/config/dhcp ] || exit 0

cur_start="$(uci -q get dhcp.lan.start)"
[ "$cur_start" = "1" ] || exit 0

uci -q set dhcp.lan.start='30'
uci -q set dhcp.lan.limit='120'
uci -q commit dhcp || exit 1

logger -t dhcp-pool-fix "DHCP 池 1-150 -> 30-149，低位段留给静态设备"
exit 0
