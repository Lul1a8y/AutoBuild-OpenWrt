#!/bin/sh
# 2026-10-23: ttyd 保持 LAN 监听, 登录由 /bin/login 把关(与上游默认一致)。
#
# 说明: 这个文件只做一件事 —— 如果 uci 里 interface 被改成了 127.0.0.1, 改回 @lan。
# 起因: 我曾把 ttyd 改成只绑回环(想减少 LAN 暴露), 结果电脑浏览器点 LuCI 的「终端」
# 就连不上; 而本包的 ttyd 没有 TLS 支持(带 -S 启动直接 rc=1, 实测), 加不了 https。
# 结论: 维持上游默认(192.168.50.2:7681 + /bin/login), 不设 HTTP Basic Auth ——
# 打开页面只是看到 login 提示, 没有 root 口令照样登不进去。
# 若以后想收紧: uci set ttyd.@ttyd[0].interface='127.0.0.1', 从电脑用
#   ssh -L 7681:127.0.0.1:7681 -p 12306 root@192.168.50.2

[ -f /etc/config/ttyd ] || exit 0

cur="$(uci -q get ttyd.@ttyd[0].interface)"
[ "${cur}" = "127.0.0.1" ] || exit 0

uci -q set ttyd.@ttyd[0].interface='@lan'
uci -q commit ttyd
/etc/init.d/ttyd restart >/dev/null 2>&1
logger -t ttyd-defaults "ttyd 由 127.0.0.1 改回 @lan(登录仍由 /bin/login 把关)"

exit 0
