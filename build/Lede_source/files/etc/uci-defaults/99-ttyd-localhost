#!/bin/sh
# 2026-10-23: ttyd 只监听回环地址。
#
# ttyd 默认 interface='@lan', 即 192.168.50.2:7681 —— 局域网内任意主机打开
# http://192.168.50.2:7681/ 就能以 root 身份拿到一个无 TLS 的明文 shell,
# 只要口令还能用就等于把 root 交出去。这里改成只绑 127.0.0.1:
#   · 在路由器本机上用      → http://127.0.0.1:7681/  (或 -i 指定的地址)
#   · 从电脑远程用          → ssh -L 7681:127.0.0.1:7681 -p 12306 root@192.168.50.2
#                             然后浏览器开 http://127.0.0.1:7681/
# 注意: LuCI 页面上的「终端」按钮是让浏览器直接连 192.168.50.2:7681, 改成回环后
# 点它连不上, 属于预期行为。想恢复成局域网可访问, 一条命令:
#   uci set ttyd.@ttyd[0].interface='@lan'; uci commit ttyd; /etc/init.d/ttyd restart
[ -f /etc/config/ttyd ] || exit 0

cur="$(uci -q get ttyd.@ttyd[0].interface)"
[ "${cur}" = "127.0.0.1" ] && exit 0

uci -q set ttyd.@ttyd[0].interface='127.0.0.1'
uci -q commit ttyd
/etc/init.d/ttyd restart >/dev/null 2>&1
logger -t ttyd-defaults "ttyd 已改为只监听 127.0.0.1 (原 interface=${cur})"

exit 0
