#!/bin/sh /etc/rc.common
# 2026-10-30: AdGuardHome 在 S95 启动，firewall 在 S19 先跑；S19 时 AGH 还没起来，
# firewall.user 的 agh_available 会返回 false，53→5553 规则不会加。
# 这个 hook 在 S96 等 AGH 进程起来后 reload 一次 fw4，让规则在开机后生效。
# AGH 停止时也 reload 一次，清掉重定向，避免客户端继续被送到空端口。

START=96
STOP=10

start() {
	[ -x /etc/init.d/AdGuardHome ] || exit 0
	/etc/init.d/AdGuardHome enabled >/dev/null 2>&1 || exit 0
	{ [ -x /usr/bin/AdGuardHome ] || [ -x /etc/AdGuardHome/AdGuardHome ]; } || exit 0

	i=0
	while [ "$i" -lt 30 ]; do
		pidof AdGuardHome >/dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done

	logger -t agh-dns-redirect "reloading firewall after AdGuardHome start" 2>/dev/null || true
	fw4 -q reload
}

stop() {
	logger -t agh-dns-redirect "reloading firewall after AdGuardHome stop" 2>/dev/null || true
	fw4 -q reload
}
