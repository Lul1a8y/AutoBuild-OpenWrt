# This file is interpreted as a shell script.
# Custom commands run after the default rules on every firewall restart.
#
# 2026-10-21: 把 LAN 的 53 统一劫持到 AdGuardHome(5553)。
# 目的: 在 ADH 的查询日志里看到真实客户端 IP —— 若客户端经 dnsmasq 转发,
# ADH 只会看到源地址 127.0.0.1, 无法区分是哪台设备在查什么。
# 代价: 客户端绕过 dnsmasq, passwall 写在 dnsmasq 里的按域名分流/ipset 注入
# 对这一路径不生效; 域名分流仍由 xray 的 sniffing + mosdns 的 geo 分流兜底。
#
# 2026-10-30: 按实际使用需求保持简单的 IPv4/IPv6 无条件劫持。
# 不再判断 AGH 核心/进程/端口；不使用 AdGuardHome 的人直接删除本文件里的规则
# （或把本文件替换成空文件），不要让 53 指向不存在的 5553。
#
# 2026-11-03: fw4 使用 nftables。inet fw4 表在每次 reload 时会重建，
# 所以这里每次执行都幂等地补回 4 条 nft 规则（IPv4/IPv6 × UDP/TCP）。
# 同时清掉旧版本由 iptables/ip6tables 写入的 53 重定向，避免两套规则并存
# 触发 LuCI 的 “检测到旧版规则” 警告。

# 迁移清理: 旧镜像曾用 iptables/ip6tables -t nat REDIRECT 5553。
for _ipt in iptables ip6tables; do
	command -v "$_ipt" >/dev/null 2>&1 || continue
	for _proto in udp tcp; do
		while "$_ipt" -t nat -C PREROUTING -i br-lan -p "$_proto" --dport 53 -j REDIRECT --to-ports 5553 2>/dev/null; do
			"$_ipt" -t nat -D PREROUTING -i br-lan -p "$_proto" --dport 53 -j REDIRECT --to-ports 5553 2>/dev/null || break
		done
	done
done
unset _ipt _proto

# nftables: comment 不能含空格，否则 nft CLI 会把 "ADH DNS ..." 拆成多个 token。
for _nfproto in ipv4 ipv6; do
	for _proto in udp tcp; do
		_comment="ADH-DNS-${_nfproto}-${_proto}"
		if ! nft list chain inet fw4 dstnat 2>/dev/null | grep -qF "$_comment"; then
			nft insert rule inet fw4 dstnat \
				meta nfproto "$_nfproto" \
				iifname "br-lan" \
				"$_proto" dport 53 \
				redirect to :5553 \
				comment "$_comment" 2>/dev/null || \
				logger -t firewall.user "添加 ADH DNS nft 规则失败: ${_comment}" 2>/dev/null || true
		fi
	done
done
unset _nfproto _proto _comment
