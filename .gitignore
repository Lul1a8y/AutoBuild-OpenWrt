upstream-audit/

# ---- 工作流直接在仓库根生成的东西 ----
# openwrt 在 CI 里是 `ln -sf /target/openwrt $GITHUB_WORKSPACE/openwrt` 的符号链接，
# 本地构建时则是真目录，所以这里不能带结尾斜杠。
/openwrt
/openwrt-armvirt/
/Github_Tags/
/fail-diag/
/BUILD_SOURCE.txt
/config.txt
/update_log.txt

# ---- 构建中途产生的临时文件 ----
*.log
.config.old
*.orig
*.rej

# ---- 编辑器 / 系统垃圾 ----
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ---- 密钥 / 证书(2026-10-22: 私钥一旦本地生成在仓库根, git add -A 就会带进去) ----
*.pem
*.key
*.p12
*.pfx
fw-signing*
!build/Lede_source/files/etc/firmware-signing.pub
