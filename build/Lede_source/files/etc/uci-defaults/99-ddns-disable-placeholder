#!/bin/sh
# 2026-10-22: ddns-scripts 自带两个示例服务(myddns_ipv4 / myddns_ipv6), 它们的
# lookup_host 是 yourhost.example.com、用户名是 your_username, 而且都没有写
# `enabled` —— ddns-scripts 把"缺省"当作启用, 于是每次开机都会去解析这个不存在的
# 域名, 日志里稳定出现:
#     ddns-scripts: myddns_ipv4 exit WITH ERROR '1'
#     ddns-scripts: myddns_ipv6 exit WITH ERROR '1'
#
# 这里只删除"仍然是占位符"的示例条目, 用户自己配置过的真实 DDNS 不受影响;
# ddns 服务本身保持启用, 以后在 LuCI 里新加一条真实配置就能直接生效。
#
# 2026-10-28 修正两处:
# 1) 原来是边遍历边删除。uci show 对匿名段输出 ddns.@service[N], 删掉 @service[0]
#    之后其余匿名段会重新编号, 循环里下一条 @service[1] 已经指向不存在的段,
#    uci get 全空 → 判定为非占位 → 漏删。改为先收集、再统一删除。
# 2) 原来"域名命中示例"与"用户名等于 your_username"是或的关系, 用户照模板改了
#    域名却忘了改用户名时, 开机就被静默删掉整条真实配置。改成: 域名是示例,
#    且用户名没填或仍是占位符, 才算示例条目(留得下用户填过的任何真实值)。
[ -f /etc/config/ddns ] || exit 0

todo=""
for s in $(uci -q show ddns | sed -n 's/^\(ddns\.[^=]*\)=service$/\1/p'); do
	host="$(uci -q get "${s}.lookup_host")"
	domain="$(uci -q get "${s}.domain")"
	user="$(uci -q get "${s}.username")"

	case "${host}${domain}" in
		*example.com*|*example.net*) ;;
		*) continue ;;
	esac
	if [ -n "${user}" ] && [ "${user}" != "your_username" ]; then
		continue
	fi
	todo="${s} ${todo}"
done

changed=0
for s in ${todo}; do
	uci -q delete "${s}" && {
		changed=1
		logger -t ddns-defaults "已移除 ddns 示例条目 ${s}"
	}
done

if [ "${changed}" = "1" ]; then
	uci -q commit ddns
fi

exit 0
