#!/bin/sh
# 2026-10-27: 停掉 /boot 的重复自动挂载。
#
# 镜像里的 /etc/config/fstab 带着 x86 模板残留:
#     config mount
#         option target '/boot'
#         option uuid 'auto'
#         option enabled '1'
# uuid 'auto' 不是 UUID, block/fstab 把它当"自动挑盘", 开机就把 sda1 挂到 /boot;
# 而 /etc/fstab 本体是空的 —— 结果 mount 输出里 /dev/sda1 on /boot 出现两次。
# 运行期没有任何东西需要 /boot, 所以只把"仍然是这条模板"的 section 的 enabled 改 0。
#
# sysupgrade 会保留 /etc/config/fstab, 所以光改镜像里的种子文件对已升级的机器无效,
# 这条 uci-defaults 负责把它们也一并修掉。
[ -f /etc/config/fstab ] || exit 0

changed=0
for s in $(uci -q show fstab | sed -n 's/^\(fstab\.[^=]*\)=mount$/\1/p'); do
	[ "$(uci -q get "${s}.target")" = "/boot" ] || continue
	[ "$(uci -q get "${s}.uuid")" = "auto" ] || continue
	[ "$(uci -q get "${s}.enabled")" = "1" ] || continue
	uci -q set "${s}.enabled=0"
	changed=1
done

if [ "${changed}" = "1" ]; then
	uci -q commit fstab
	logger -t fstab-defaults "已停用 /boot 的模板自动挂载(原先会被挂两遍)"
fi

exit 0
