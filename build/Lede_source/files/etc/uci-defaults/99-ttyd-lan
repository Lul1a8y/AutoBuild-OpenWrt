#!/bin/sh
# 2026-10-30: 按实际使用需求保持 ttyd 在 LAN 监听。
# ttyd 本身没有 TLS，但登录由 /bin/login + root 密码把关；本机 LAN 是可信任网络时，
# 这比把 LuCI 的「终端」按钮改坏更实用。不要把 7681 暴露到 WAN。
# 如果确实要只绑回环，需要修改这个 uci-defaults 脚本本身，否则升级会改回 @lan。
#
# 旧逻辑只在 interface 被改成 127.0.0.1 时改回 @lan；保留这个行为。

[ -f /etc/config/ttyd ] || exit 0

cur="$(uci -q get ttyd.@ttyd[0].interface)"
[ "${cur}" = "127.0.0.1" ] || exit 0

uci -q set ttyd.@ttyd[0].interface='@lan'
uci -q commit ttyd
/etc/init.d/ttyd restart >/dev/null 2>&1
logger -t ttyd-defaults "ttyd 由 127.0.0.1 改回 @lan(登录仍由 /bin/login 把关)"

exit 0
