#!/bin/sh
# This file is interpreted as a shell script.
# Custom commands run after the default rules on every firewall restart.
#
# 2026-10-21: 把 LAN 的 53 统一劫持到 AdGuardHome(5553)。
# 目的: 在 ADH 的查询日志里看到真实客户端 IP —— 若客户端经 dnsmasq 转发,
# ADH 只会看到源地址 127.0.0.1, 无法区分是哪台设备在查什么。
# 代价: 客户端绕过 dnsmasq, passwall 写在 dnsmasq 里的按域名分流/ipset 注入
# 对这一路径不生效; 域名分流仍由 xray 的 sniffing + mosdns 的 geo 分流兜底。
#
# 2026-10-30: 按实际使用需求保持简单的 IPv4/IPv6 无条件劫持。
# 不再判断 AGH 核心/进程/端口；不使用 AdGuardHome 的人直接删除本文件里的规则
# （或把本文件替换成空文件），不要让 53 指向不存在的 5553。
#
# 2026-11-08: 改用 fw4/nftables，并改成“先加 nft，再清旧 iptables”。
# 原因: 本文件在每次 fw4 reload 都会执行；若先删旧规则、后加 nft,
# nft 失败时会出现“旧规则已删、新规则没加”的空窗。现在任一 nft 失败
# 都会 exit 1；注意 fw4 的 run_includes 只会记录 warning 并继续，不会让 reload 返回失败，
# 但会终止本脚本，避免继续清理旧规则。只有 4 条 nft 规则确认存在后，
# 才清理历史遗留的 iptables/ip6tables REDIRECT。
# 不使用带空格的 comment：nft CLI 会重新拆分参数，导致 command line 语法错误。
#
# 写法说明: 裸 nft insert 会叠加；这里先 grep 同 comment 的规则，重复执行
# 结果恒定。fw4 reload 会重建 inet fw4 表，本脚本负责把 4 条规则重新加回。

add_nft_dns_redirect() {
	nfproto="$1"
	proto="$2"
	comment="ADH-DNS-${nfproto}-${proto}"

	if ! nft list chain inet fw4 dstnat 2>/dev/null | grep -qF "$comment"; then
		if ! nft insert rule inet fw4 dstnat \
			meta nfproto "$nfproto" \
			iifname "br-lan" \
			"$proto" dport 53 \
			redirect to :5553 \
			comment "$comment"; then
			logger -t firewall.user "failed to add nft DNS redirect ${comment}"
			exit 1
		fi
	fi
}

for nfproto in ipv4 ipv6; do
	for proto in udp tcp; do
		add_nft_dns_redirect "$nfproto" "$proto"
	done
done

# 4 条 nft 规则必须全部存在；缺一条就失败，不能静默通过。
nft_count="$(nft list chain inet fw4 dstnat 2>/dev/null | grep -c 'ADH-DNS-' || true)"
if [ "${nft_count:-0}" -ne 4 ]; then
	logger -t firewall.user "expected 4 nft DNS redirects, found ${nft_count:-0}"
	exit 1
fi

# 清理旧版 iptables/ip6tables 规则。它们不会被 fw4 reload 自动清掉。
for ipt in iptables ip6tables; do
	command -v "$ipt" >/dev/null 2>&1 || continue
	for proto in udp tcp; do
		while "$ipt" -t nat -C PREROUTING -i br-lan -p "$proto" \
			--dport 53 -j REDIRECT --to-ports 5553 2>/dev/null; do
			"$ipt" -t nat -D PREROUTING -i br-lan -p "$proto" \
				--dport 53 -j REDIRECT --to-ports 5553 2>/dev/null || break
		done
	done
done

unset nfproto proto comment ipt nft_count
